# Copy this file to .env and fill in real values.

# Apollo.io API key — required by the prospecting agent (app/agents/prospecting.py)
APOLLO_API_KEY=your_apollo_api_key_here

# Flask config
FLASK_SECRET_KEY=dev-secret-change-me
DATABASE_URL=sqlite:///ai_sdr.db

# Optional AI-written opening; templates work without these.
OPENAI_API_KEY=
# Choose a Responses API model that supports Structured Outputs.
OPENAI_MODEL=
